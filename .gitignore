# Dependencies
node_modules/
backend/node_modules/
admin-dashboard/node_modules/

# Environment variables
.env
backend/.env
admin-dashboard/.env
.env.local
.env.*.local

# Build outputs
dist/
build/
admin-dashboard/dist/
backend/dist/

# public/ is a build artifact generated by scripts/copy-static-files.sh
# Edit source files in the root js/, css/, images/ directories instead.
# public/logo.png is kept (no root counterpart).
public/js/
public/css/
public/images/
public/fonts/
public/videos/
public/documents/
public/assets/
public/admin/
public/*.html

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Database
*.db
*.sqlite

# Prisma
# Note: Keep migrations in repo, but ignore generated files
backend/prisma/migrations/*.sql
!backend/prisma/migrations/**/*.sql

# Supabase
backend/.supabase/
*.supabase

# Logs
backend/logs/
*.log

# Temporary files
*.tmp
*.temp

# TypeScript incremental build cache
*.tsbuildinfo

# Claude Code: share the launch configs (how to run this project), keep the
# per-developer bits out. settings.local.json holds one developer's permission
# grants; scheduled_tasks.lock holds a pid for the machine that wrote it.
.claude/*
!.claude/launch.json

# Built timetable payloads. The public one is committed so the site can be
# deployed without a FET install; the staff one carries every teacher's name and
# location for every period, so it is generated on demand, never committed and
# never copied into public/.
data/timetable-staff.json
# Intermediate parse of the .fet - large, and regenerated by timetable:parse.
data/timetable-2026-2027.json
