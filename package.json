{
  "name": "york-castle-high-school",
  "version": "1.0.0",
  "description": "York Castle High School - Full Web Application",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema=./backend/prisma/schema.prisma",
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd admin-dashboard && npm install",
    "dev": "npm run build:frontend && npm run dev:backend",
    "dev:separate": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd admin-dashboard && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd admin-dashboard && npm install && npm run build",
    "build:production": "NODE_ENV=production npm run build:frontend",
    "start": "cd backend && npm start",
    "start:production": "NODE_ENV=production cd backend && npm start",
    "db:migrate": "cd backend && npm run prisma:migrate",
    "db:seed": "cd backend && npm run prisma:seed",
    "db:studio": "cd backend && npm run prisma:studio"
  },
  "keywords": [
    "school",
    "management",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "resend": "^3.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.7.1"
  }
}

