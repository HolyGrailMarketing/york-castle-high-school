// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

enum RequestType {
  DOCUMENT
  DEVICE
  LAB
  GENERAL
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String?      // Optional for OAuth users
  name          String
  role          UserRole     @default(STUDENT)
  phone         String?
  provider      AuthProvider @default(EMAIL)
  providerId    String?      // Google user ID
  picture       String?      // Profile picture URL

  // Submission notification routing - which inbound submissions this user is emailed about
  notifyGeneralRequests Boolean @default(false)
  notifySixthFormApps   Boolean @default(false)
  notifyAdmissions      Boolean @default(false)
  // Escalation routing - who is emailed when a document request misses the
  // turnaround promised on doc-request.html. Intended for the principal.
  notifyOverdueRequests Boolean @default(false)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  applications         Application[]
  sixthFormApplications SixthFormApplication[]
  enrollments          Enrollment[]
  requests             Request[]
  assignedRequests     Request[] @relation("AssignedRequests")
  blogPosts            BlogPost[] @relation("Author")
  events               Event[] @relation("Creator")
  consentRecords       ConsentRecord[]
  dataSubjectRequests  DataSubjectRequest[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role])
  @@index([provider])
  @@index([providerId])
}

model Application {
  id              String            @id @default(uuid())
  firstName       String
  middleName      String?
  lastName         String
  email           String
  phone           String
  dateOfBirth     DateTime
  address         String?
  previousSchool  String?
  gradeApplying   Int
  status          ApplicationStatus  @default(PENDING)
  notes           String?           @db.Text
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
}

model SixthFormApplication {
  id              String            @id @default(uuid())
  firstName       String
  middleName      String?
  lastName        String
  email           String
  phone           String
  dateOfBirth     DateTime
  address         String?
  gender          String?
  religion        String?
  nationality     String?
  yearsOfResidence Int?
  previousSchool  String?
  positionsHeld      String?  @db.Text
  guardianInfo       Json?
  careerGoals        String?  @db.Text
  strengthsWeaknesses String? @db.Text
  reasonForAttending String?  @db.Text
  csecResults     Json?            // Store CSEC results as JSON
  subjectChoices  Json             // Store subject pool selections
  status          ApplicationStatus @default(PENDING)
  // The faculty the student has been placed in for September — the school's
  // decision, set from the final candidate lists once selection is done.
  // Deliberately not part of `subjectChoices`: everything in there is what the
  // applicant asked for, and the two are not the same. A student can be placed
  // in a faculty they did not name.
  faculty         String?
  notes           String?          @db.Text
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  interviewInvitedAt DateTime?     // set when a bulk interview-invitation email is sent; independent of `status`
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  interview       SixthFormInterview?
  notifications   SixthFormNotification[]

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
  // A case-insensitive unique index on lower(email) enforces one application
  // per applicant. Expression indexes can't be declared here, so it lives in
  // migrations/20260820140000_sixth_form_unique_email — do not drop it.
}

model SixthFormNotification {
  id            String               @id @default(uuid())
  applicationId String
  application   SixthFormApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String               // 'INTERVIEW_INVITATION' | 'CXC_RESULTS_RELEASED' | 'CUSTOM'
  subject       String
  sentAt        DateTime             @default(now())
  sentBy        String?              // admin user id

  @@index([applicationId])
  @@index([type])
}

// A one-time link letting a named candidate past the closed application form.
//
// The token is a random string looked up here rather than a signed JWT: signing
// requires the signer and the verifier to share a secret, and the scripts that
// issue invites run on a staff machine while verification happens in
// production. They already share this database, so the database is the thing to
// trust. It also makes an invite revocable and lets us see who has responded,
// neither of which a stateless token allows.
model SixthFormInvite {
  id         String    @id @default(uuid())
  token      String    @unique
  email      String
  firstName  String
  lastName   String
  faculty    String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  createdBy  String?
  // When an application was submitted on this invite. Recorded for chasing up
  // the ones who have not responded; it is not what stops a second application
  // — the unique index on lower(email) does that.
  usedAt     DateTime?
  revokedAt  DateTime?

  @@index([email])
  @@index([expiresAt])
}

model SixthFormInterview {
  id                    String               @id @default(uuid())
  applicationId         String               @unique
  application           SixthFormApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentName           String
  fullyMatriculated     Boolean              @default(false)
  awarenessMotivation   Int?                 // 1–5 rating
  knowledgeOfSchool     Int?                 // 1–5 rating
  appearance            Int?                 // 1–5 rating
  generalSuitability    Int?                 // 1–5 rating
  comments              String?              @db.Text
  decision              String               // RECOMMEND | DO_NOT_RECOMMEND | DEFER
  createdByName         String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([applicationId])
}

model Course {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?  @db.Text
  pool          Int?     // Subject pool number (1-6)
  teacher       String?
  passRate      Float?
  capacity      Int?
  enrolled      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]

  @@index([pool])
  @@index([isActive])
}

model Enrollment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade       Float?
  enrolledAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  featuredImage String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  author      User     @relation("Author", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  image       String?
  isPublic    Boolean  @default(true)
  creatorId   String
  creator     User     @relation("Creator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([isPublic])
}

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  filePath    String
  fileName    String
  fileSize    Int
  mimeType    String
  category    String?
  isPublic    Boolean  @default(false)
  downloadCount Int    @default(0)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// One booklist file per grade, per school year - what booklist.html renders.
// Files live in Supabase Storage (see src/services/storageService.js) rather
// than on local disk, because the serverless filesystem is ephemeral.
model BooklistEntry {
  id          String   @id @default(uuid())
  schoolYear  String   // e.g. "2025-2026" - also drives the heading on booklist.html
  gradeLabel  String   // e.g. "Grade 7", "Sixth Form"
  fileName    String
  fileUrl     String   // public URL; may point at Storage or a legacy /documents path
  storagePath String?  // key within the Storage bucket; null for legacy /documents files
  fileSize    Int?
  mimeType    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolYear, gradeLabel])
  @@index([isPublished, sortOrder])
  @@index([schoolYear])
}

model Request {
  id          String      @id @default(uuid())
  type        RequestType
  title       String
  description String?     @db.Text
  status      RequestStatus @default(PENDING)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo  User?       @relation("AssignedRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt  DateTime?
  metadata    Json?       // Store request-specific data
  response    String?     @db.Text
  respondedAt DateTime?
  // Stamped once the principal has been emailed about this request running past
  // its promised turnaround, so the escalation fires exactly once. See
  // src/services/overdueRequestService.js
  escalatedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([title])
}

model Teacher {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String?
  department  String?
  subjects    String[] // Array of subjects taught
  bio         String?   @db.Text
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetableLinks TimetableTeacher[]

  @@index([department])
  @@index([isActive])
}

model Analytics {
  id          String   @id @default(uuid())
  eventType   String   // 'page_view', 'form_submission', 'download', etc.
  entityType  String?  // 'application', 'blog_post', 'document', etc.
  entityId    String?
  userId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([entityType])
  @@index([createdAt])
}

model ConsentRecord {
  id            String   @id @default(uuid())
  userId        String?  // Nullable for anonymous consent (cookie consent)
  email         String?  // Email for cookie consent tracking
  consentType   String   // 'cookie_analytics', 'data_processing', 'marketing', etc.
  purpose       String   // Purpose for which consent was given
  granted       Boolean  @default(true)
  withdrawnAt   DateTime?
  ipAddress     String?
  userAgent     String?
  consentMethod String   // 'banner', 'form', 'api', etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([consentType])
  @@index([createdAt])
}

model DataSubjectRequest {
  id              String   @id @default(uuid())
  requestType     String   // 'access', 'correction', 'deletion', 'portability', 'restriction', 'objection'
  userId          String?
  email           String   // Required for unauthenticated requests
  name            String?
  phone           String?
  description     String?  @db.Text
  status          String   @default("PENDING")
  response        String?  @db.Text
  responseData    Json?    // For access requests - exported data
  verifiedAt      DateTime?
  completedAt     DateTime?
  completedBy     String?  // Admin user ID who processed it
  rejectionReason String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String   // 'create', 'read', 'update', 'delete', 'export', 'access'
  entityType    String   // 'User', 'Application', 'Request', etc.
  entityId      String
  userId        String?  // User who performed the action
  userEmail     String?  // For audit purposes even if user deleted
  ipAddress     String?
  userAgent     String?
  changes       Json?    // Store before/after values for updates
  metadata      Json?    // Additional context
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}


// ---------------------------------------------------------------------------
// Timetable
//
// The school's master timetable, imported from the FET .fet file that has been
// the only source until now. Moving it here is what lets the office edit a
// lesson without a round-trip through FET on someone's desktop.
//
// The published version is exported back out to data/timetable-public.json by
// scripts/timetable/export-from-db.js; timetable.html is pre-rendered from that
// file at build time, so the public page keeps working with JavaScript off.
// ---------------------------------------------------------------------------

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TimetableVersion {
  id          String          @id @default(uuid())
  schoolYear  String          // e.g. "2026-2027"
  label       String          // what an admin calls this draft
  status      TimetableStatus @default(DRAFT)
  publishedAt DateTime?
  createdBy   String?
  sourceFile  String?         // the .fet it was imported from, if any
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  periods    TimetablePeriod[]
  groups     TimetableGroup[]
  teachers   TimetableTeacher[]
  rooms      TimetableRoom[]
  activities TimetableActivity[]

  @@index([schoolYear])
  @@index([status])
  // Only one PUBLISHED version per school year. Enforced in the controller too,
  // because Prisma cannot express a partial unique index.
  @@index([schoolYear, status])
}

model TimetablePeriod {
  id          String  @id @default(uuid())
  versionId   String
  version     TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key         String  // "p1", "break" - stable id used by placements
  label       String  // "Period 1"
  sortOrder   Int
  startTime   String? // 24-hour "08:20"; null for a period with no recorded time
  endTime     String?
  altStart    String? // the shortened-morning bell, where the school runs one
  altEnd      String?
  kind        String  // class | break | lunch | registration | other
  lunchSitting Int?
  // Some periods carry a registration window inside them - Period 6 runs
  // 13:40-14:50 with registration for its first ten minutes. Without these the
  // exported payload loses that detail.
  regStart    String?
  regEnd      String?
  unused      Boolean @default(false) // in the grid but never scheduled
  sourceLabel String? // the original FET "hour" name; the join key back to FET

  @@unique([versionId, key])
  @@index([versionId, sortOrder])
}

model TimetableGroup {
  id        String  @id @default(uuid())
  versionId String
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String  // "7Y", or "11" where the year is not divided
  yearName  String  // "7"
  undivided Boolean @default(false)
  sortOrder Int     @default(0)

  @@unique([versionId, name])
  @@index([versionId, yearName])
}

model TimetableTeacher {
  id        String  @id @default(uuid())
  versionId String
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String  // the FET spelling, e.g. "Gordon   M" - the join key
  teacherId String? // optional link to the site's own Teacher record
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([versionId, name])
  @@index([teacherId])
}

model TimetableRoom {
  id        String  @id @default(uuid())
  versionId String
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String

  @@unique([versionId, name])
}

model TimetableActivity {
  id           String  @id @default(uuid())
  versionId    String
  version      TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceId     String? // the FET <Id>, kept so a re-import can be matched up
  subject      String
  duration     Int     @default(1) // in periods
  isActive     Boolean @default(true)
  // Lunch duty and CPS: staff roster entries, not lessons. Excluded from the
  // public payload and from every class timetable.
  staffOnly    Boolean @default(false)
  room         String?
  // Plain arrays rather than join tables, matching Teacher.subjects. Clash
  // detection runs in JavaScript over a whole version, so join tables would add
  // a lot of code for no query benefit.
  teacherNames String[]
  groupNames   String[]

  placement TimetablePlacement?

  @@index([versionId])
  @@index([versionId, staffOnly])
}

model TimetablePlacement {
  id         String  @id @default(uuid())
  versionId  String
  activityId String  @unique
  activity   TimetableActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  day        String  // "Monday"
  periodKey  String  // matches TimetablePeriod.key
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([versionId, day, periodKey])
}
