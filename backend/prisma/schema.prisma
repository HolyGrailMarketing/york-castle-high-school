// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

enum RequestType {
  DOCUMENT
  DEVICE
  LAB
  GENERAL
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String?      // Optional for OAuth users
  name          String
  role          UserRole     @default(STUDENT)
  phone         String?
  provider      AuthProvider @default(EMAIL)
  providerId    String?      // Google user ID
  picture       String?      // Profile picture URL

  // Submission notification routing - which inbound submissions this user is emailed about
  notifyGeneralRequests Boolean @default(false)
  notifySixthFormApps   Boolean @default(false)
  notifyAdmissions      Boolean @default(false)
  // Escalation routing - who is emailed when a document request misses the
  // turnaround promised on doc-request.html. Intended for the principal.
  notifyOverdueRequests Boolean @default(false)
  // Overdue-textbook routing - who is emailed the daily digest of books that
  // have run past their return date. A separate list from
  // notifyOverdueRequests: the librarian wants the books, the principal wants
  // the document requests.
  notifyOverdueBooks    Boolean @default(false)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  applications         Application[]
  sixthFormApplications SixthFormApplication[]
  enrollments          Enrollment[]
  requests             Request[]
  assignedRequests     Request[] @relation("AssignedRequests")
  blogPosts            BlogPost[] @relation("Author")
  events               Event[] @relation("Creator")
  consentRecords       ConsentRecord[]
  dataSubjectRequests  DataSubjectRequest[]
  auditLogs            AuditLog[]

  // Textbook rental
  studentProfile       StudentProfile?  @relation("StudentProfile")
  verifiedProfiles     StudentProfile[] @relation("StudentProfileVerifier")
  bookLoans            BookLoan[]       @relation("BookLoans")
  bookLoansIssued      BookLoan[]       @relation("BookLoansIssued")
  bookLoansReturned    BookLoan[]       @relation("BookLoansReturned")
  bookCharges          BookCharge[]     @relation("BookCharges")
  bookChargesRaised    BookCharge[]     @relation("BookChargesRaised")

  @@index([email])
  @@index([role])
  @@index([provider])
  @@index([providerId])
}

model Application {
  id              String            @id @default(uuid())
  firstName       String
  middleName      String?
  lastName         String
  email           String
  phone           String
  dateOfBirth     DateTime
  address         String?
  previousSchool  String?
  gradeApplying   Int
  status          ApplicationStatus  @default(PENDING)
  notes           String?           @db.Text
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
}

model SixthFormApplication {
  id              String            @id @default(uuid())
  firstName       String
  middleName      String?
  lastName        String
  email           String
  phone           String
  dateOfBirth     DateTime
  address         String?
  gender          String?
  religion        String?
  nationality     String?
  yearsOfResidence Int?
  previousSchool  String?
  positionsHeld      String?  @db.Text
  guardianInfo       Json?
  careerGoals        String?  @db.Text
  strengthsWeaknesses String? @db.Text
  reasonForAttending String?  @db.Text
  csecResults     Json?            // Store CSEC results as JSON
  subjectChoices  Json             // Store subject pool selections
  status          ApplicationStatus @default(PENDING)
  // The faculty the student has been placed in for September — the school's
  // decision, set from the final candidate lists once selection is done.
  // Deliberately not part of `subjectChoices`: everything in there is what the
  // applicant asked for, and the two are not the same. A student can be placed
  // in a faculty they did not name.
  faculty         String?
  notes           String?          @db.Text
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  interviewInvitedAt DateTime?     // set when a bulk interview-invitation email is sent; independent of `status`
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  interview       SixthFormInterview?
  notifications   SixthFormNotification[]

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
  // Present in the database since 20260828230000_add_sixth_form_faculty; the
  // matching line was missed here, so every later `migrate diff` wanted to drop
  // the index. Do not remove.
  @@index([faculty])
  // A case-insensitive unique index on lower(email) enforces one application
  // per applicant. Expression indexes can't be declared here, so it lives in
  // migrations/20260820140000_sixth_form_unique_email — do not drop it.
}

model SixthFormNotification {
  id            String               @id @default(uuid())
  applicationId String
  application   SixthFormApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String               // 'INTERVIEW_INVITATION' | 'CXC_RESULTS_RELEASED' | 'CUSTOM'
  subject       String
  sentAt        DateTime             @default(now())
  sentBy        String?              // admin user id

  @@index([applicationId])
  @@index([type])
}

// A one-time link letting a named candidate past the closed application form.
//
// The token is a random string looked up here rather than a signed JWT: signing
// requires the signer and the verifier to share a secret, and the scripts that
// issue invites run on a staff machine while verification happens in
// production. They already share this database, so the database is the thing to
// trust. It also makes an invite revocable and lets us see who has responded,
// neither of which a stateless token allows.
model SixthFormInvite {
  id         String    @id @default(uuid())
  token      String    @unique
  email      String
  firstName  String
  lastName   String
  faculty    String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  createdBy  String?
  // When an application was submitted on this invite. Recorded for chasing up
  // the ones who have not responded; it is not what stops a second application
  // — the unique index on lower(email) does that.
  usedAt     DateTime?
  revokedAt  DateTime?

  @@index([email])
  @@index([expiresAt])
}

model SixthFormInterview {
  id                    String               @id @default(uuid())
  applicationId         String               @unique
  application           SixthFormApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentName           String
  fullyMatriculated     Boolean              @default(false)
  awarenessMotivation   Int?                 // 1–5 rating
  knowledgeOfSchool     Int?                 // 1–5 rating
  appearance            Int?                 // 1–5 rating
  generalSuitability    Int?                 // 1–5 rating
  comments              String?              @db.Text
  decision              String               // RECOMMEND | DO_NOT_RECOMMEND | DEFER
  createdByName         String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([applicationId])
}

model Course {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?  @db.Text
  pool          Int?     // Subject pool number (1-6)
  teacher       String?
  passRate      Float?
  capacity      Int?
  enrolled      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]

  @@index([pool])
  @@index([isActive])
}

model Enrollment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade       Float?
  enrolledAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  featuredImage String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  author      User     @relation("Author", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  image       String?
  isPublic    Boolean  @default(true)
  creatorId   String
  creator     User     @relation("Creator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([isPublic])
}

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  filePath    String
  fileName    String
  fileSize    Int
  mimeType    String
  category    String?
  isPublic    Boolean  @default(false)
  downloadCount Int    @default(0)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// One booklist file per grade, per school year - what booklist.html renders.
// Files live in Supabase Storage (see src/services/storageService.js) rather
// than on local disk, because the serverless filesystem is ephemeral.
model BooklistEntry {
  id          String   @id @default(uuid())
  schoolYear  String   // e.g. "2025-2026" - also drives the heading on booklist.html
  gradeLabel  String   // e.g. "Grade 7", "Sixth Form"
  fileName    String
  fileUrl     String   // public URL; may point at Storage or a legacy /documents path
  storagePath String?  // key within the Storage bucket; null for legacy /documents files
  fileSize    Int?
  mimeType    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolYear, gradeLabel])
  @@index([isPublished, sortOrder])
  @@index([schoolYear])
}

model Request {
  id          String      @id @default(uuid())
  type        RequestType
  title       String
  description String?     @db.Text
  status      RequestStatus @default(PENDING)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo  User?       @relation("AssignedRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt  DateTime?
  metadata    Json?       // Store request-specific data
  response    String?     @db.Text
  respondedAt DateTime?
  // Stamped once the principal has been emailed about this request running past
  // its promised turnaround, so the escalation fires exactly once. See
  // src/services/overdueRequestService.js
  escalatedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([title])
}

model Teacher {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String?
  department  String?
  subjects    String[] // Array of subjects taught
  bio         String?   @db.Text
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([isActive])
}

model Analytics {
  id          String   @id @default(uuid())
  eventType   String   // 'page_view', 'form_submission', 'download', etc.
  entityType  String?  // 'application', 'blog_post', 'document', etc.
  entityId    String?
  userId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([entityType])
  @@index([createdAt])
}

model ConsentRecord {
  id            String   @id @default(uuid())
  userId        String?  // Nullable for anonymous consent (cookie consent)
  email         String?  // Email for cookie consent tracking
  consentType   String   // 'cookie_analytics', 'data_processing', 'marketing', etc.
  purpose       String   // Purpose for which consent was given
  granted       Boolean  @default(true)
  withdrawnAt   DateTime?
  ipAddress     String?
  userAgent     String?
  consentMethod String   // 'banner', 'form', 'api', etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([consentType])
  @@index([createdAt])
}

model DataSubjectRequest {
  id              String   @id @default(uuid())
  requestType     String   // 'access', 'correction', 'deletion', 'portability', 'restriction', 'objection'
  userId          String?
  email           String   // Required for unauthenticated requests
  name            String?
  phone           String?
  description     String?  @db.Text
  status          String   @default("PENDING")
  response        String?  @db.Text
  responseData    Json?    // For access requests - exported data
  verifiedAt      DateTime?
  completedAt     DateTime?
  completedBy     String?  // Admin user ID who processed it
  rejectionReason String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String   // 'create', 'read', 'update', 'delete', 'export', 'access'
  entityType    String   // 'User', 'Application', 'Request', etc.
  entityId      String
  userId        String?  // User who performed the action
  userEmail     String?  // For audit purposes even if user deleted
  ipAddress     String?
  userAgent     String?
  changes       Json?    // Store before/after values for updates
  metadata      Json?    // Additional context
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Textbook rental
//
// Authority rule, and the reason the offline counter is safe:
//
//   BookLoan is authoritative for "who has this copy".
//   BookCopy.status is a derived cache.
//
// The guarantee is a partial unique index that Prisma cannot express here and
// which is therefore hand-written into the migration SQL:
//
//   CREATE UNIQUE INDEX "BookLoan_one_active_per_copy"
//     ON public."BookLoan" ("copyId") WHERE status = 'ACTIVE';
//
// That single line is what stops two offline stations that cannot see each
// other from both issuing the same physical book. The second one to sync gets
// a P2002 from Postgres instead of quietly creating a second live loan.
//
// BookCopy.status is kept in the same transaction as every loan mutation. It
// exists because inventory queries would otherwise need a correlated subquery
// on every row, and because it can express states a loan cannot: WITHDRAWN,
// REPAIR, and LOST-while-on-the-shelf. scripts/reconcile-copy-status.js
// recomputes it from loans, so drift is detectable rather than theoretical.
// ---------------------------------------------------------------------------

/// One scale, used for shelf condition, condition at issue and condition at return.
enum BookCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

/// Where the physical object is, from the school's point of view.
enum CopyStatus {
  AVAILABLE
  ON_LOAN
  REPAIR
  LOST
  WITHDRAWN // soft delete: retired from circulation, history preserved
}

enum LoanStatus {
  ACTIVE
  RETURNED
  LOST
  WRITTEN_OFF
}

/// Whether this was recorded live or replayed from a station's offline queue.
enum LoanSource {
  ONLINE
  OFFLINE_SYNC
}

enum ChargeType {
  RENTAL
  LOST
  DAMAGE
}

/// Deliberately no PAID. This system records what is owed; the bursary takes
/// the money and records the payment in its own books.
enum ChargeStatus {
  OUTSTANDING
  WAIVED
}

enum StudentVerification {
  UNVERIFIED
  VERIFIED
  REJECTED
}

/// School-specific fields for a student's own account. Students sign up
/// themselves, so everything here starts unconfirmed and the office checks it
/// against the class register before any book is handed over.
model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("StudentProfile", fields: [userId], references: [id], onDelete: Cascade)

  // Confirmed by the office. Null until someone has checked the class register.
  studentNumber String? @unique
  yearGroup     Int? // 7..13
  formClass     String? // "7Y", "9R" - validated against services/schoolClasses.js

  // What the student typed at sign-up, frozen. Never overwritten, so staff can
  // see what was claimed and a self-declared year can never pass as confirmed.
  claimedYearGroup Int?
  claimedFormClass String?

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  verification     StudentVerification @default(UNVERIFIED)
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?               @relation("StudentProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  /// The librarian created this account at the counter rather than the student
  /// signing up themselves. Kept so "how did this account appear" is answerable.
  registeredAtDesk Boolean             @default(false)
  /// Per-student override of the school-wide borrowing limit. Null = default.
  loanCap          Int?
  notes            String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verification])
  @@index([yearGroup, formClass])
  @@index([formClass])
}

/// A title the school lends. The physical objects are BookCopy.
model Book {
  id              String   @id @default(uuid())
  title           String
  author          String?
  publisher       String?
  edition         String?
  /// Nullable-unique: Postgres allows many NULLs, so untracked titles coexist.
  isbn            String?  @unique
  subject         String
  /// A book can serve more than one year, e.g. [9, 10].
  yearGroups      Int[]
  replacementCost Decimal  @db.Decimal(10, 2)
  rentalFee       Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  copies BookCopy[]

  @@index([subject])
  @@index([isActive])
  @@index([title])
}

/// One physical book with its own barcode label. Twenty copies of the same
/// title are twenty rows, which is how the school can say which one a
/// particular student has and what condition that one was in.
model BookCopy {
  id              String        @id @default(uuid())
  bookId          String
  book            Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  barcode         String        @unique // "YCHS-000123"
  copyNumber      Int // sequential within the book
  condition       BookCondition @default(GOOD)
  status          CopyStatus    @default(AVAILABLE)
  acquiredAt      DateTime?
  /// Groups one "add 120 copies" run so its labels can be reprinted later.
  batchId         String?
  withdrawnAt     DateTime?
  withdrawnReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  loans   BookLoan[]
  charges BookCharge[]

  @@unique([bookId, copyNumber])
  @@index([status])
  @@index([bookId, status])
  @@index([batchId])
}

model BookLoan {
  id        String   @id @default(uuid())
  copyId    String
  copy      BookCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)
  studentId String
  student   User     @relation("BookLoans", fields: [studentId], references: [id], onDelete: Restrict)

  /// Copied from the current AcademicTerm at issue, so history survives the
  /// term rolling over.
  academicYear String
  term         Int?
  status       LoanStatus @default(ACTIVE)

  /// issuedAt is the effective time and may have come from an offline device
  /// (corrected for clock skew, then clamped). issuedServerAt is when the row
  /// was actually written. Both, always - you need the second to debug the first.
  issuedAt        DateTime
  issuedServerAt  DateTime      @default(now())
  issuedById      String
  issuedBy        User          @relation("BookLoansIssued", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedCondition BookCondition
  /// Always computed server-side from AcademicTerm.endsOn, so a wrong clock on
  /// a counter laptop can never produce a wrong due date.
  dueAt           DateTime

  returnedAt        DateTime?
  returnedServerAt  DateTime?
  returnedById      String?
  returnedBy        User?          @relation("BookLoansReturned", fields: [returnedById], references: [id], onDelete: SetNull)
  returnedCondition BookCondition?
  conditionNote     String?        @db.Text

  // Offline sync. The op ids are client-generated UUIDs and are the
  // idempotency keys: a retried request whose response was lost replays onto
  // the same row instead of creating a second loan.
  issueOpId    String      @unique
  returnOpId   String?     @unique
  issueSource  LoanSource  @default(ONLINE)
  returnSource LoanSource?
  stationId    String?
  /// Accepted, but a human should look at it. Set when sync takes a record
  /// that policy would have refused at the counter - the book has already left
  /// the building, so refusing the record would destroy the only trace of it.
  needsReview  Boolean     @default(false)
  reviewReason String?

  // Notification stamps, mirroring Request.escalatedAt: written only after the
  // send succeeds, so an email outage retries next run instead of losing the
  // alert. Two separate stamps because "the student was told" and "staff were
  // told" are different facts.
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?
  escalatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges BookCharge[]

  @@index([studentId, status])
  @@index([status, dueAt])
  @@index([copyId, status])
  @@index([academicYear, term])
  @@index([needsReview])
}

/// What a student owes. Recording only - no payment is ever taken or recorded
/// here; that happens at the bursary.
model BookCharge {
  id        String    @id @default(uuid())
  studentId String
  student   User      @relation("BookCharges", fields: [studentId], references: [id], onDelete: Restrict)
  loanId    String?
  loan      BookLoan? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  copyId    String?
  copy      BookCopy? @relation(fields: [copyId], references: [id], onDelete: SetNull)

  type         ChargeType
  amount       Decimal      @db.Decimal(10, 2)
  currency     String       @default("JMD")
  academicYear String
  term         Int?
  status       ChargeStatus @default(OUTSTANDING)
  reason       String?      @db.Text

  raisedById  String?
  raisedBy    User?     @relation("BookChargesRaised", fields: [raisedById], references: [id], onDelete: SetNull)
  raisedAt    DateTime  @default(now())
  waivedById  String?
  waivedAt    DateTime?
  waiveReason String?

  /// Idempotency key when a damage charge is raised from an offline station.
  opId      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One RENTAL, one LOST and one DAMAGE per loan. This is what stops a
  /// replayed op from charging a student twice.
  @@unique([loanId, type])
  @@index([studentId, status])
  @@index([status, academicYear])
}

/// The single source of truth for "what year and term is it". Never derive
/// this from new Date() - dueAt and every overdue calculation come from here.
model AcademicTerm {
  id           String   @id @default(uuid())
  academicYear String // "2026-2027"
  term         Int // 1 | 2 | 3
  startsOn     DateTime
  endsOn       DateTime // the default dueAt for loans issued in this term
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // + hand-added partial unique index in the migration, so only one row can be
  // current:
  //   CREATE UNIQUE INDEX "AcademicTerm_one_current"
  //     ON public."AcademicTerm" ((true)) WHERE "isCurrent";

  @@unique([academicYear, term])
}

/// Allocates sequential copy barcodes. A single row, incremented inside the
/// same transaction as the createMany that consumes the numbers, so two admins
/// generating copies at the same time cannot collide. Deliberately not
/// MAX(barcode)+1, which races.
model BarcodeCounter {
  id        String   @id @default("copy")
  prefix    String   @default("YCHS-")
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}
