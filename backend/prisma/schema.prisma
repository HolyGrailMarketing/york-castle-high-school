// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  STUDENT
  PARENT
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

enum RequestType {
  DOCUMENT
  DEVICE
  LAB
  GENERAL
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String?      // Optional for OAuth users
  name          String
  role          UserRole     @default(STUDENT)
  phone         String?
  provider      AuthProvider @default(EMAIL)
  providerId    String?      // Google user ID
  picture       String?      // Profile picture URL
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  applications         Application[]
  sixthFormApplications SixthFormApplication[]
  enrollments          Enrollment[]
  requests             Request[]
  blogPosts            BlogPost[] @relation("Author")
  events               Event[] @relation("Creator")

  @@index([email])
  @@index([role])
  @@index([provider])
  @@index([providerId])
}

model Application {
  id              String            @id @default(uuid())
  firstName       String
  middleName      String?
  lastName         String
  email           String
  phone           String
  dateOfBirth     DateTime
  address         String?
  previousSchool  String?
  gradeApplying   Int
  status          ApplicationStatus  @default(PENDING)
  notes           String?           @db.Text
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
}

model SixthFormApplication {
  id              String            @id @default(uuid())
  firstName       String
  middleName      String?
  lastName        String
  email           String
  phone           String
  dateOfBirth     DateTime
  address         String?
  previousSchool  String?
  csecResults     Json?            // Store CSEC results as JSON
  subjectChoices  Json             // Store subject pool selections
  status          ApplicationStatus @default(PENDING)
  notes           String?          @db.Text
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
}

model Course {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?  @db.Text
  pool          Int?     // Subject pool number (1-6)
  teacher       String?
  passRate      Float?
  capacity      Int?
  enrolled      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]

  @@index([pool])
  @@index([isActive])
}

model Enrollment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade       Float?
  enrolledAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  featuredImage String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  author      User     @relation("Author", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  image       String?
  isPublic    Boolean  @default(true)
  creatorId   String
  creator     User     @relation("Creator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([isPublic])
}

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  filePath    String
  fileName    String
  fileSize    Int
  mimeType    String
  category    String?
  isPublic    Boolean  @default(false)
  downloadCount Int    @default(0)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model Request {
  id          String      @id @default(uuid())
  type        RequestType
  title       String
  description String?     @db.Text
  status      RequestStatus @default(PENDING)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata    Json?       // Store request-specific data
  response    String?     @db.Text
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([title])
}

model Teacher {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String?
  department  String?
  subjects    String[] // Array of subjects taught
  bio         String?   @db.Text
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([isActive])
}

model Analytics {
  id          String   @id @default(uuid())
  eventType   String   // 'page_view', 'form_submission', 'download', etc.
  entityType  String?  // 'application', 'blog_post', 'document', etc.
  entityId    String?
  userId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([entityType])
  @@index([createdAt])
}

