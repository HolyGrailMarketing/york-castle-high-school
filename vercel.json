{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**",
          "admin-dashboard/dist/**",
          "index.html",
          "*.html",
          "css/**",
          "js/**",
          "images/**",
          "fonts/**",
          "videos/**",
          "documents/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.mjs"
    }
  ],
  "installCommand": "npm install && cd admin-dashboard && npm install && npm run build && cd ../backend && npm run prisma:generate"
}
