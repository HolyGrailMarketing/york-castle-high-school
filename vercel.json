{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/**",
          "admin-dashboard/dist/**",
          "**/*.html",
          "css/**",
          "js/**",
          "images/**",
          "fonts/**",
          "videos/**",
          "documents/**",
          "dashboard/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.mjs"
    }
  ],
  "installCommand": "npm install && cd admin-dashboard && npm install && npm run build && cd .. && npx prisma generate --schema=./backend/prisma/schema.prisma"
}
