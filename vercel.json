{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/**",
          "admin-dashboard/dist/**",
          "**/*.html",
          "css/**",
          "js/**",
          "images/**",
          "fonts/**",
          "videos/**",
          "documents/**",
          "dashboard/**"
        ],
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "admin-dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "admin-dashboard/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/src/server.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin-dashboard/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/src/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "backend/src/server.js": {
      "maxDuration": 30
    }
  }
}
