{
  "version": 2,
  "installCommand": "npm install && cd backend && npm install && cd ../admin-dashboard && npm install && cd ..",
  "buildCommand": "npx --yes prisma generate --schema=./backend/prisma/schema.prisma && cd admin-dashboard && npm run build && cd .. && (mkdir -p public && cp -r admin-dashboard/dist/. public/ || true)",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.mjs"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.mjs"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|webp|mp4|webm|pdf|docx|json))",
      "dest": "/api/index.mjs",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": [
        "backend/**",
        "node_modules/.prisma/**",
        "node_modules/@prisma/**"
      ]
    }
  }
}
